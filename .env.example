# CYAZOR STRATEGY ENGINE - INFRASTRUCTURE KEYS

# Google Gemini (Brain/Deep Reasoning)
# Note: Platform injects GEMINI_API_KEY, prefix VITE_ not required if using process.env
GEMINI_API_KEY=

# Groq (Extreme Speed / Fast Inference)
VITE_GROQ_API_KEY=

# Hugging Face (Embeddings / Vector Generation)
VITE_HF_TOKEN=

# Supabase (Vector Database / Long-term Memory)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Application Mode
VITE_APP_ENV=production
